    "load:test": "tsx scripts/load-test.ts",
    "capsule:bench": "tsx scripts/capsule-bench.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
