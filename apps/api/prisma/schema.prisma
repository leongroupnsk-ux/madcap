// Схема БД v1 — ТЗ §9. Деньги в копейках (Int), время в UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Пользователи и доступ ──────────────────────────────────────────────

enum UserRole {
  buyer
  supplier_staff
  admin
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String
  role               UserRole   @default(buyer)
  phone              String?
  emailVerifiedAt    DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  /// Роль сотрудника платформы (для role = admin); null — владелец со всеми правами (ТЗ §8)
  staffRole          StaffRole?
  /// Блокировка администратором: вход и сессии недоступны
  blockedAt          DateTime?
  blockReason        String?
  /// Последняя активность: от неё считается срок хранения фото (12 месяцев, ТЗ §11)
  lastActiveAt       DateTime   @default(now())
  /// TOTP-секрет (base32); 2FA обязательна для владельца поставщика по желанию, для админа — рекомендуется
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// Покупатель отписался от писем «Оставьте отзыв» (профиль или ссылка в письме); null — письма приходят
  reviewInvitesOffAt DateTime?

  sessions             Session[]
  tokens               AuthToken[]
  consents             Consent[]
  stylistRequests      StylistRequest[]
  buyerProfile         BuyerProfile?
  capsules             Capsule[]
  supplierMembers      SupplierMember[]
  cartItems            CartItem[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  addresses            Address[]
  orders               Order[]
  returnRequests       ReturnRequest[]
  auditLogs            AuditLog[]
  premiumAnswers       PremiumAnswers?
  premiumLeads         PremiumLead[]
  newsletterDeliveries NewsletterDelivery[]
  reviews              Review[]
  favorites            Favorite[]
  restockSubscriptions RestockSubscription[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// sha256 от значения cookie — сама cookie в БД не хранится
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Роли сотрудников админки (ТЗ §8)
enum StaffRole {
  owner
  moderator
  editor
  support
  stylist
}

enum AuthTokenType {
  email_verify
  password_reset
  supplier_invite
}

/// Одноразовые токены: подтверждение email, сброс пароля, приглашение поставщика.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

enum ConsentType {
  pdn
  offer
  photos
  marketing
}

model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  type      ConsentType
  version   String
  grantedAt DateTime    @default(now())
  revokedAt DateTime?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

// ─── Профиль покупателя (анкета, ТЗ §5) ─────────────────────────────────

enum Gender {
  female
  male
  unisex
}

model BuyerProfile {
  userId          String    @id @db.Uuid
  gender          Gender?
  name            String?
  age             Int?
  heightCm        Int?
  weightKg        Int?
  sizeTop         String?
  sizeBottom      String?
  sizeShoes       String?
  bodyType        String?
  skinTone        String?
  hair            String?
  eyes            String?
  colorType       String?
  /// Предусмотрено на случай решения по дресс-коду клиники (ТЗ §14)
  dressCode       String?
  budgetRange     String?
  completenessPct Int       @default(0)
  /// Анкета пройдена до шага «Создать мой профиль»
  quizCompletedAt DateTime?
  /// Первый сохранённый ответ анкеты — начало воронки подбора на дашборде (запись профиля создаётся и при просмотре /account)
  quizStartedAt   DateTime?
  updatedAt       DateTime  @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties ProfileSpecialty[]
  photos      ProfilePhoto[]

  @@map("buyer_profiles")
}

model ProfileSpecialty {
  profileId   String @db.Uuid
  specialtyId String @db.Uuid

  profile   BuyerProfile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  specialty Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([profileId, specialtyId])
  @@map("profile_specialties")
}

enum PhotoAngle {
  front
  side
  back
  three_quarter
}

model ProfilePhoto {
  id         String      @id @default(uuid()) @db.Uuid
  profileId  String      @db.Uuid
  storageKey String
  angle      PhotoAngle?
  createdAt  DateTime    @default(now())

  profile BuyerProfile @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@map("profile_photos")
}

// ─── Справочники ────────────────────────────────────────────────────────

model SpecialtyGroup {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  position    Int         @default(0)
  specialties Specialty[]

  @@map("specialty_groups")
}

model Specialty {
  id       String @id @default(uuid()) @db.Uuid
  groupId  String @db.Uuid
  name     String
  slug     String @unique
  /// Требования к ткани/обработке и набор слотов капсулы — для движка подбора
  rules    Json   @default("{}")
  position Int    @default(0)

  group    SpecialtyGroup     @relation(fields: [groupId], references: [id])
  profiles ProfileSpecialty[]
  products ProductSpecialty[]

  @@map("specialties")
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  name     String
  slug     String  @unique
  /// Слот капсулы, который закрывает категория (top, pants, gown, shoes, accessory)
  slot     String?
  position Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Color {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  hex         String
  /// Цветовая группа для сочетаемости и палитр цветотипов
  colorFamily String

  variants ProductVariant[]
  media    ProductMedia[]

  @@map("colors")
}

model Brand {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique
  slug      String @unique
  sizeChart Json?

  products Product[]

  @@map("brands")
}

// ─── Поставщики ─────────────────────────────────────────────────────────

enum SupplierStatus {
  pending
  active
  blocked
}

enum PayoutStatus {
  not_connected
  in_review
  active
}

model Supplier {
  id                String         @id @default(uuid()) @db.Uuid
  legalName         String
  inn               String         @unique
  kpp               String?
  status            SupplierStatus @default(pending)
  /// Комиссия в базисных пунктах: 1000 = 10%
  commissionBp      Int            @default(1000)
  yookassaAccountId String?
  payoutStatus      PayoutStatus   @default(not_connected)
  warehouseAddress  String?
  cdekCityCode      Int?
  shipDays          Int            @default(1)
  ymlFeedUrl        String?
  /// Пункт СДЭК, куда поставщик сдаёт посылки (тарифы «склад-…»)
  cdekShipmentPoint String?
  /// Ставка НДС для чека 54-ФЗ (код ЮKassa: 1 — без НДС)
  vatCode           Int            @default(1)
  /// Реквизиты получателя выплат; изменение — повторный онбординг ЮKassa (ТЗ §7.8)
  payoutLegalName   String?
  payoutInn         String?
  payoutAccount     String?
  payoutBik         String?
  payoutRequestedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  description  String?
  /// Контакты, переданные при подключении
  contactName  String?
  contactPhone String?
  contactEmail String?

  members              SupplierMember[]
  products             Product[]
  imports              ImportJob[]
  application          SupplierApplication?
  articles             Article[]
  collections          Collection[]
  shipments            Shipment[]
  payouts              Payout[]
  promotionProducts    PromotionProduct[]
  notificationSettings NotificationSetting[]
  feedSchedule         SupplierFeedSchedule?
  apiKeys              PartnerApiKey[]

  @@map("suppliers")
}

enum SupplierMemberRole {
  owner
  catalog
  warehouse
}

model SupplierMember {
  supplierId String             @db.Uuid
  userId     String             @db.Uuid
  role       SupplierMemberRole @default(owner)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([supplierId, userId])
  @@map("supplier_members")
}

// ─── Каталог ────────────────────────────────────────────────────────────

enum ModerationStatus {
  draft
  pending
  published
  rejected
  hidden
}

enum ProductSource {
  manual
  file
  yml
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  supplierId       String           @db.Uuid
  brandId          String           @db.Uuid
  categoryId       String           @db.Uuid
  slug             String           @unique
  title            String
  gender           Gender           @default(unisex)
  fabric           String?
  treatment        String?
  washing          String?
  description      String?
  moderationStatus ModerationStatus @default(draft)
  rejectReason     String?
  source           ProductSource    @default(manual)
  /// Ручные правки медиа/описания защищены от перезаписи YML-синком (ТЗ §7.3)
  manualOverride   Boolean          @default(false)
  /// Премиум-коллекция: участвует в премиальном подборе (/premium), продаётся и обычным путём
  premium          Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  brand       Brand     @relation(fields: [brandId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])
  submittedAt DateTime?
  publishedAt DateTime?
  /// Внешний id из YML/файла — для сопоставления при повторном импорте
  externalId  String?

  variants     ProductVariant[]
  media        ProductMedia[]
  specialties  ProductSpecialty[]
  promotions   PromotionProduct[]
  revisions    ProductRevision[]
  articles     ArticleProduct[]
  collections  CollectionProduct[]
  capsuleItems CapsuleItem[]
  reviews      Review[]
  favorites    Favorite[]
  dailyStats   ProductDailyStat[]

  @@unique([supplierId, externalId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@index([supplierId])
  @@index([categoryId, moderationStatus])
  @@map("products")
}

model ProductSpecialty {
  productId   String @db.Uuid
  specialtyId String @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([productId, specialtyId])
  @@map("product_specialties")
}

model ProductVariant {
  id              String  @id @default(uuid()) @db.Uuid
  productId       String  @db.Uuid
  sku             String
  size            String
  /// Ростовка: «170–176»
  heightRange     String?
  colorId         String  @db.Uuid
  price           Int
  oldPrice        Int?
  stock           Int     @default(0)
  /// Цена по акции платформы (ТЗ §7.7): рассчитывается из price, базовую цену не трогает; null — без акции
  salePrice       Int?
  salePromotionId String? @db.Uuid
  weightG         Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  color                Color                 @relation(fields: [colorId], references: [id])
  capsuleItems         CapsuleItem[]
  cartItems            CartItem[]
  orderItems           ShipmentItem[]
  salePromotion        Promotion?            @relation(fields: [salePromotionId], references: [id], onDelete: SetNull)
  restockSubscriptions RestockSubscription[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

enum MediaType {
  photo
  video
}

model ProductMedia {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  type       MediaType
  storageKey String
  posterKey  String?
  position   Int       @default(0)
  isMain     Boolean   @default(false)
  /// Фото конкретного цвета; null — общее для всех цветов (ТЗ §4.3: фото меняются по цвету)
  colorId    String?   @db.Uuid
  /// Медиа, добавленные к опубликованному товару, видны на витрине только после модерации ревизии
  approved   Boolean   @default(false)
  /// Ссылка-источник при импорте (для повторного синка без перекачки)
  sourceUrl  String?
  width      Int?
  height     Int?
  durationS  Float?
  sizeBytes  Int?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_media")
}

// ─── Этап 1: подключение поставщиков, модерация, импорт ─────────────────

enum ApplicationStatus {
  new
  approved
  rejected
}

model SupplierApplication {
  id           String            @id @default(uuid()) @db.Uuid
  company      String
  inn          String
  contactName  String
  phone        String
  email        String
  assortment   String
  status       ApplicationStatus @default(new)
  rejectReason String?
  supplierId   String?           @unique @db.Uuid
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  ip           String?

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([status, createdAt])
  @@map("supplier_applications")
}

enum RevisionStatus {
  pending
  approved
  rejected
}

/// Правки текста/медиа опубликованного товара, ждущие модерации (ТЗ §7.3).
/// На витрине до одобрения остаётся опубликованная версия.
model ProductRevision {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String         @db.Uuid
  /// { title, description, fabric, treatment, washing, gender, categoryId, brandId, specialtyIds[], media: { order[], mainId, removed[] } }
  data         Json
  status       RevisionStatus @default(pending)
  rejectReason String?
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("product_revisions")
}

enum ImportSource {
  file
  yml
}

enum ImportStatus {
  queued
  checking
  checked
  applying
  applied
  failed
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  supplierId  String       @db.Uuid
  source      ImportSource
  fileName    String?
  fileKey     String?
  feedUrl     String?
  status      ImportStatus @default(queued)
  totalRows   Int          @default(0)
  newProducts Int          @default(0)
  updates     Int          @default(0)
  errorRows   Int          @default(0)
  /// Первые 200 ошибок: [{ row, field, message }]
  errors      Json         @default("[]")
  /// Нормализованные валидные строки для применения
  payload     Json?
  failReason  String?
  createdAt   DateTime     @default(now())
  checkedAt   DateTime?
  appliedAt   DateTime?
  autoApply   Boolean      @default(false)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
  @@map("import_jobs")
}

model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  actorId  String?  @db.Uuid
  action   String
  entity   String
  entityId String?
  data     Json?
  at       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@map("audit_log")
}

// ─── Этап 2: журнал (статьи и подборки поставщиков и редакции) ──────────

enum ContentStatus {
  draft
  pending
  published
  rejected
}

model Article {
  id           String        @id @default(uuid()) @db.Uuid
  /// null — материал редакции платформы
  supplierId   String?       @db.Uuid
  slug         String        @unique
  title        String
  lead         String?
  coverKey     String?
  /// HTML после серверной санитизации по белому списку тегов
  body         String        @default("")
  status       ContentStatus @default(draft)
  rejectReason String?
  submittedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  products ArticleProduct[]

  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleProduct {
  articleId String @db.Uuid
  productId String @db.Uuid
  position  Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@map("article_products")
}

model Collection {
  id           String        @id @default(uuid()) @db.Uuid
  supplierId   String?       @db.Uuid
  slug         String        @unique
  title        String
  description  String?
  coverKey     String?
  status       ContentStatus @default(draft)
  rejectReason String?
  submittedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  products CollectionProduct[]

  @@index([status, publishedAt])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @db.Uuid
  productId    String @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

// ─── Этап 3: подбор капсулы (ТЗ §5) ─────────────────────────────────────

/// Один из трёх вариантов капсулы пользователя (разные основные цвета).
model Capsule {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  variantNo    Int
  total        Int
  /// Причины рекомендации для блока «Почему мы рекомендуем»
  explanations Json     @default("[]")
  builtAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CapsuleItem[]

  @@unique([userId, variantNo])
  @@map("capsules")
}

model CapsuleItem {
  id           String  @id @default(uuid()) @db.Uuid
  capsuleId    String  @db.Uuid
  slot         String
  position     Int     @default(0)
  productId    String? @db.Uuid
  variantId    String? @db.Uuid
  /// Топ-4 замены: [{ productId, variantId }]
  alternatives Json    @default("[]")
  /// Выбрано покупателем вручную — пересборка не трогает
  pinned       Boolean @default(false)

  capsule Capsule         @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([capsuleId, slot])
  @@map("capsule_items")
}

// ─── Этап 4: корзина, заказы, оплата, доставка, выплаты ─────────────────

/// Корзина вошедшего покупателя; у гостя — в браузере (ТЗ §6.1)
model CartItem {
  userId      String   @db.Uuid
  variantId   String   @db.Uuid
  qty         Int
  fromCapsule Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
  @@map("cart_items")
}

enum DeliveryType {
  pvz
  courier
}

model Address {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  type       DeliveryType
  cityCode   Int
  city       String
  /// Курьер: улица и дом
  street     String?
  flat       String?
  intercom   String?
  entrance   String?
  floor      String?
  comment    String?
  /// ПВЗ: код и адрес пункта
  pvzCode    String?
  pvzAddress String?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

enum OrderStatus {
  pending_payment
  paid
  cancelled
}

enum PaymentStatus {
  pending
  succeeded
  canceled
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  /// Номер для покупателя: 100001, 100002…
  number          String        @unique
  userId          String        @db.Uuid
  status          OrderStatus   @default(pending_payment)
  paymentStatus   PaymentStatus @default(pending)
  paymentId       String?       @unique
  /// «Карта •••• 1234» / «СБП»
  paymentMethod   String?
  confirmationUrl String?
  goodsTotal      Int
  deliveryTotal   Int
  total           Int
  recipientName   String
  recipientPhone  String
  recipientEmail  String
  /// Резерв остатков и срок оплаты; после — отмена (ТЗ §6.3)
  expiresAt       DateTime
  paidAt          DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  /// split — деньги поставщикам переводит ЮKassa; registry — аварийный режим, платформа платит реестром (ТЗ §8)
  settlement      Settlement    @default(split)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  shipments   Shipment[]
  refunds     Refund[]
  /// Заказ, созданный менеджером из премиум-заявки
  premiumLead PremiumLead?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

enum Settlement {
  split
  registry
}

enum ShipmentStatus {
  awaiting_payment
  new
  confirmed
  packed
  handed_over
  in_transit
  ready_for_pickup
  delivered
  cancelled
  rejected
}

/// Отправление: часть заказа от одного поставщика (ТЗ §6)
model Shipment {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid
  supplierId        String         @db.Uuid
  no                Int
  status            ShipmentStatus @default(awaiting_payment)
  deliveryType      DeliveryType
  tariffCode        Int
  cityCode          Int
  /// Адрес строкой для экранов; детали — в addressJson
  address           String
  pvzCode           String?
  addressJson       Json           @default("{}")
  deliveryPrice     Int
  periodMin         Int
  periodMax         Int
  eta               DateTime?
  goodsTotal        Int
  commissionBp      Int
  commission        Int
  cdekUuid          String?        @unique
  trackNo           String?
  rejectReason      String?
  paidAt            DateTime?
  /// Уведомление «не подтверждён 24 ч» отправлено
  overdueNotifiedAt DateTime?
  /// Письмо «Оставьте отзыв» через 7 дней после доставки отправлено или пропущено (одно на отправление)
  reviewInviteAt    DateTime?
  confirmedAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  items    ShipmentItem[]
  events   ShipmentEvent[]
  payouts  Payout[]
  refunds  Refund[]
  returns  ReturnRequest[]

  @@unique([orderId, no])
  @@index([supplierId, status])
  @@index([status, deliveredAt])
  @@map("shipments")
}

/// Снимок товара на момент покупки
model ShipmentItem {
  id           String  @id @default(uuid()) @db.Uuid
  shipmentId   String  @db.Uuid
  variantId    String? @db.Uuid
  productSlug  String?
  title        String
  brand        String
  sku          String
  size         String
  heightRange  String?
  color        String
  imageKey     String?
  price        Int
  qty          Int
  returnedQty  Int     @default(0)
  fromCapsule  Boolean @default(false)
  /// Комиссия по позиции: льготная, если товар куплен по акции
  commissionBp Int     @default(1000)
  promotionId  String? @db.Uuid
  weightG      Int     @default(400)

  shipment Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("shipment_items")
}

model ShipmentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  status     String
  note       String?
  at         DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, at])
  @@map("shipment_events")
}

enum PayoutKind {
  sale
  refund
}

/// Строка перечислений поставщику: продажа (+) или возврат (−) (ТЗ §7.8)
model Payout {
  id          String     @id @default(uuid()) @db.Uuid
  shipmentId  String     @db.Uuid
  supplierId  String     @db.Uuid
  kind        PayoutKind
  amountGoods Int
  commission  Int
  transferred Int
  /// Заказ в аварийном режиме: перечисляет платформа по реестру, а не ЮKassa
  manual      Boolean    @default(false)
  registryId  String?    @db.Uuid
  createdAt   DateTime   @default(now())

  shipment Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  registry PayoutRegistry? @relation(fields: [registryId], references: [id])

  @@index([supplierId, createdAt])
  @@index([manual, registryId])
  @@map("payouts")
}

/// Реестр ручных выплат поставщикам в аварийном режиме (ТЗ §8)
model PayoutRegistry {
  id        String    @id @default(uuid()) @db.Uuid
  number    Int       @unique @default(autoincrement())
  total     Int
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  paidBy    String?   @db.Uuid

  payouts Payout[]

  @@map("payout_registries")
}

enum RefundStatus {
  pending
  succeeded
  canceled
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  shipmentId       String?      @db.Uuid
  amount           Int
  goodsAmount      Int
  commission       Int
  reason           String
  providerRefundId String?      @unique
  idempotenceKey   String       @unique
  status           RefundStatus @default(pending)
  createdAt        DateTime     @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@map("refunds")
}

enum ReturnStatus {
  requested
  approved
  rejected
}

/// Возврат доставленного отправления в течение 7 дней (ТЗ §6.6).
/// ВНИМАНИЕ: в миграции stage6_security есть частичный уникальный индекс return_requests_one_open_per_shipment
/// (shipmentId WHERE status = 'requested'); Prisma его не описывает — при migrate diff не удалять.
model ReturnRequest {
  id           String       @id @default(uuid()) @db.Uuid
  shipmentId   String       @db.Uuid
  userId       String       @db.Uuid
  /// [{ itemId, qty }]
  items        Json
  reason       String
  amount       Int
  status       ReturnStatus @default(requested)
  rejectReason String?
  createdAt    DateTime     @default(now())
  decidedAt    DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("return_requests")
}

/// Журнал входящих уведомлений платёжки и СДЭК — для идемпотентности
model WebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  objectId  String
  event     String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([source, objectId, event])
  @@map("webhook_events")
}

// ─── Этап 5: акции, уведомления ─────────────────────────────────────────

/// Акция платформы (ТЗ §7.7, §8): поставщики заявляют товары со скидкой
model Promotion {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  description    String   @default("")
  /// Бейдж на карточке товара: «Неделя хирурга»
  badge          String
  minDiscountPct Int
  /// Льготная комиссия на время акции, базисные пункты: 800 = 8%
  commissionBp   Int
  applyFrom      DateTime
  applyTo        DateTime
  startsAt       DateTime
  endsAt         DateTime
  onHomepage     Boolean  @default(false)
  newsletter     Boolean  @default(false)
  requirements   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products             PromotionProduct[]
  variants             ProductVariant[]
  newsletterCampaign   NewsletterCampaign?
  newsletterDeliveries NewsletterDelivery[]

  @@map("promotions")
}

enum NewsletterStatus {
  queued
  running
  done
  failed
}

/// Рассылка покупателям по акции (ТЗ §7.7, §11): одна на акцию, повторный запуск дошлёт тем, кто ещё не получил
model NewsletterCampaign {
  id          String           @id @default(uuid()) @db.Uuid
  promotionId String           @unique @db.Uuid
  status      NewsletterStatus @default(queued)
  /// Получателей на момент последнего запуска (с согласием marketing)
  total       Int              @default(0)
  sent        Int              @default(0)
  failed      Int              @default(0)
  error       String?
  startedById String?          @db.Uuid
  queuedAt    DateTime         @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("newsletter_campaigns")
}

enum NewsletterDeliveryStatus {
  sending
  sent
  failed
}

/// Отправка письма по акции одному человеку — уникальна, поэтому повторный запуск не дублирует письма
model NewsletterDelivery {
  id          String                   @id @default(uuid()) @db.Uuid
  promotionId String                   @db.Uuid
  userId      String                   @db.Uuid
  status      NewsletterDeliveryStatus @default(sending)
  error       String?
  createdAt   DateTime                 @default(now())
  sentAt      DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId])
  @@index([userId])
  @@map("newsletter_deliveries")
}

enum PromotionProductStatus {
  pending
  approved
  rejected
}

model PromotionProduct {
  id           String                 @id @default(uuid()) @db.Uuid
  promotionId  String                 @db.Uuid
  productId    String                 @db.Uuid
  supplierId   String                 @db.Uuid
  discountPct  Int
  status       PromotionProductStatus @default(pending)
  rejectReason String?
  createdAt    DateTime               @default(now())
  decidedAt    DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([supplierId])
  @@map("promotion_products")
}

/// Центр уведомлений (колокольчик) кабинета поставщика (ТЗ §7.9)
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  supplierId String?   @db.Uuid
  event      String
  title      String
  body       String    @default("")
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Каналы и события уведомлений сотрудника поставщика
model NotificationSetting {
  userId         String   @db.Uuid
  supplierId     String   @db.Uuid
  email          Boolean  @default(true)
  telegramChatId String?
  /// Выключенные события: ["import_report", …]
  mutedEvents    String[] @default([])
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([userId, supplierId])
  @@map("notification_settings")
}

/// Настройки платформы, которые меняет админ без выкладки (ТЗ §8: комиссия по умолчанию, таймауты)
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("platform_settings")
}

/// Версии юридических текстов из админки (ТЗ §8, §11). Не редактируются — каждая правка новая версия;
/// пока версий нет, сайт показывает черновик из кода.
model LegalVersion {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String
  version     Int
  title       String
  html        String
  note        String   @default("")
  publishedBy String   @db.Uuid
  publishedAt DateTime @default(now())

  @@unique([slug, version])
  @@map("legal_versions")
}

enum StylistRequestStatus {
  open
  answered
  cancelled
}

/// Запрос покупателя на консультацию стилиста (ТЗ §8, §11). Анкету и фото стилист видит,
/// только пока запрос открыт, и только если покупатель разрешил показать фото; каждый просмотр — в аудит.
/// Одновременно один открытый запрос — частичный уникальный индекс в миграции stylist_requests.
model StylistRequest {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  question    String
  sharePhotos Boolean
  status      StylistRequestStatus @default(open)
  answer      String?
  stylistId   String?              @db.Uuid
  createdAt   DateTime             @default(now())
  answeredAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("stylist_requests")
}

/// Ответы премиум-анкеты вошедшего покупателя (гость хранит черновик в браузере)
model PremiumAnswers {
  userId      String    @id @db.Uuid
  answers     Json
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("premium_answers")
}

enum PremiumLeadStatus {
  new
  in_progress
  done
  cancelled
}

enum PremiumContact {
  phone
  whatsapp
}

/// Заявка «Оставить заявку» из премиум-капсулы: менеджер перезванивает, онлайн-оплаты нет
model PremiumLead {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String?           @db.Uuid
  name           String
  phone          String
  contact        PremiumContact
  /// Снимок капсулы на момент заявки: вариант, вещи с ценами, сумма
  capsule        Json
  /// Ответы анкеты на момент заявки
  answers        Json
  status         PremiumLeadStatus @default(new)
  managerComment String?
  ip             String?
  /// Заказ, созданный менеджером из заявки кнопкой «Создать заказ»
  orderId        String?           @unique @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("premium_leads")
}

// ─── Улучшения продукта: отзывы, избранное, «Сообщить о поступлении» ─────

enum ReviewStatus {
  pending
  approved
  rejected
}

/// «Размер подошёл»: маломерит / в размер / большемерит
enum ReviewFit {
  small
  true_to_size
  large
}

/// Отзыв покупателя о товаре. Оставить можно только после доставки (позиция в отправлении delivered, возвращена
/// не целиком), один на товар от покупателя; новый и отредактированный отзыв ждёт модерации.
/// Ответ продавца — один, публикуется сразу (без модерации), но виден только у одобренного отзыва.
model Review {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @db.Uuid
  userId        String       @db.Uuid
  /// Имя на витрине — снимок имени из анкеты на момент отзыва; после удаления аккаунта — «Покупатель»
  authorName    String
  rating        Int
  fit           ReviewFit
  text          String
  /// Ключи фото в хранилище (public/reviews/<uuid>.webp), до 3, без EXIF
  photos        String[]     @default([])
  status        ReviewStatus @default(pending)
  rejectReason  String?
  moderatedAt   DateTime?
  moderatedById String?      @db.Uuid
  /// Когда отзыв впервые одобрен — дата на витрине
  publishedAt   DateTime?
  reply         String?
  replyAt       DateTime?
  replyById     String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status, publishedAt])
  @@index([status, updatedAt])
  @@index([userId])
  @@map("reviews")
}

/// Избранное вошедшего покупателя; у гостя — в браузере, переносится при входе
model Favorite {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

/// Подписка «Сообщить о поступлении» на вариант (цвет + размер + ростовка). Одна строка на вариант и email:
/// после письма подписка закрыта (notifiedAt), повторная подписка открывает её снова.
model RestockSubscription {
  id          String    @id @default(uuid()) @db.Uuid
  variantId   String    @db.Uuid
  /// Вошедший покупатель; у гостя — null
  userId      String?   @db.Uuid
  email       String
  /// Гость дал согласие на обработку email (152-ФЗ); у вошедшего — согласие при регистрации
  consentAt   DateTime  @default(now())
  ip          String?
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?
  cancelledAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([variantId, email])
  @@index([email])
  @@index([userId])
  @@map("restock_subscriptions")
}

/// Поисковые запросы без результатов (аналитика каталога): нормализованный текст, сколько раз искали, когда последний раз.
/// Без ПДн: ни пользователя, ни IP; запросы, похожие на email или телефон, не пишутся.
model SearchEmptyQuery {
  query   String   @id
  count   Int      @default(1)
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())

  @@index([lastAt])
  @@map("search_empty_queries")
}

/// Переопределённый в админке шаблон письма (реестр шаблонов — apps/api/src/mail-templates/registry.ts).
/// Нет строки — действует текст по умолчанию из кода; «Сбросить к стандартному» удаляет строку.
model MailTemplate {
  key         String   @id
  subject     String
  text        String
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("mail_templates")
}

// ─── Кабинет поставщика: автоимпорт, партнёрский API, аналитика ─────────

/// Расписание синка YML-фида (ссылка — suppliers.ymlFeedUrl). Нет строки — каждые 6 ч, без паузы.
model SupplierFeedSchedule {
  supplierId  String    @id @db.Uuid
  /// Частота: 1, 6 или 24 часа (не чаще раза в час)
  everyHours  Int       @default(6)
  /// Пауза: поставщиком (pauseReason = manual) или автоматически после 3 ошибок подряд (errors)
  pausedAt    DateTime?
  pauseReason String?
  /// Ошибок подряд; сбрасывается успешным синком, сменой ссылки или включением
  failures    Int       @default(0)
  /// Последний запуск по расписанию или вручную — от него считается следующий
  lastRunAt   DateTime?
  updatedAt   DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_feed_schedules")
}

/// Ключ партнёрского API поставщика (docs/PARTNER_API.md). Сам ключ показывается один раз, хранится SHA-256.
model PartnerApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  supplierId  String    @db.Uuid
  name        String
  /// Начало ключа для списка: «ak_3fA9»
  prefix      String
  hash        String    @unique
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("partner_api_keys")
}

/// Агрегаты по товару за день (по Москве) для аналитики поставщика: просмотры карточки и добавления в корзину. Без ПДн.
model ProductDailyStat {
  productId String   @db.Uuid
  day       DateTime @db.Date
  views     Int      @default(0)
  cartAdds  Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, day])
  @@index([day])
  @@map("product_daily_stats")
}
