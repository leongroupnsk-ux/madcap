# Ключи хранилища для копий бэкапа вне сервера. На сервере — /etc/aesculap/backup.env, права 600, владелец root
# (ops/setup-server.sh создаёт пустой файл). Читает только ops/backup-cron.sh; в .env.production не переносить.
#
# Бакет — в РФ (ТЗ §11), приватный, с правилом жизненного цикла «удалять через 30 дней». Ключ — сервисного аккаунта
# только с правом записи в этот бакет (в Yandex Cloud — роль storage.uploader на бакет).

# Yandex Object Storage
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
# Selectel: S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru S3_REGION=ru-1
# VK Cloud:  S3_ENDPOINT=https://hb.ru-msk.vkcloud-storage.ru S3_REGION=ru-msk
S3_BUCKET=
S3_PREFIX=aesculap
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Сколько дней держать копии на самом сервере
KEEP_DAYS=14
# Демо-стенд без хранилища вне сервера: не считать это ошибкой
# ALLOW_LOCAL_ONLY=1
