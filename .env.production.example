# Боевые переменные для docker-compose.prod.yml. Скопировать в .env.production (в git не попадает) и заполнить.
# Секреты храните в менеджере секретов / на сервере с правами 600, не в репозитории (ТЗ §11).

DOMAIN=example.ru
POSTGRES_PASSWORD=
BRAND_NAME=aesculap

# Оплата: ЮKassa для платформ (сплитование)
PAYMENTS_DRIVER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Доставка: СДЭК API v2 (боевой контур)
DELIVERY_DRIVER=cdek
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# Почта: SMTP транзакционного сервиса в РФ (SPF/DKIM/DMARC настроить на домене)
MAIL_DRIVER=smtp
SMTP_URL=
MAIL_FROM=aesculap <noreply@example.ru>
ALERT_EMAIL=

# Telegram-бот уведомлений поставщикам (пусто — выключен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

STOREFRONT_REQUIRE_PAYOUTS=true

# Демо-стенд без ключей: заглушки оплаты/доставки/почты, закрыт от поисковиков, пароль демо-входов
# ALLOW_TEST_PROVIDERS=1
# SITE_NOINDEX=1
# DEMO_PASSWORD=
ORDER_PAY_MINUTES=30
SHIPMENT_CONFIRM_HOURS=48
STORAGE_DRIVER=local

# Реквизиты оператора для /legal/* (сервис web)
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Подпись ссылок «Отписаться» в рассылках (случайная строка; при смене старые ссылки перестанут работать)
UNSUBSCRIBE_SECRET=

# Интеграции по ключам (пусто — выключены, сайт работает как без них). Ключи — только в окружении API,
# браузеру ключ клиента капчи и ключ карт отдаёт API, поэтому смена ключа не требует пересборки web.
# Яндекс SmartCaptcha (капча после превышения лимитов входа/регистрации/сброса/заявки): задаются парой
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=
# Яндекс Карты JS API 3.x — карта ПВЗ при оформлении (ключ ограничить по HTTP Referer своим доменом)
YMAPS_API_KEY=
# Яндекс Метрика — номер счётчика (только цифры). Пусто — счётчика нет; с номером грузится только после согласия
# на аналитические cookie в баннере. Вебвизор выключен. Цели: quiz_done, capsule_to_cart, order_placed, premium_request
METRIKA_ID=
# DaData — подсказки адреса курьера (API-ключ «Подсказок»)
DADATA_API_KEY=
