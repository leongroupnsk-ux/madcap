# Боевые переменные для docker-compose.prod.yml. Скопировать в .env.production (в git не попадает) и заполнить.
# Секреты храните в менеджере секретов / на сервере с правами 600, не в репозитории (ТЗ §11).

DOMAIN=example.ru
POSTGRES_PASSWORD=
BRAND_NAME=aesculap

# Оплата: ЮKassa для платформ (сплитование)
PAYMENTS_DRIVER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Доставка: СДЭК API v2 (боевой контур)
DELIVERY_DRIVER=cdek
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# Почта: SMTP транзакционного сервиса в РФ (SPF/DKIM/DMARC настроить на домене)
MAIL_DRIVER=smtp
SMTP_URL=
MAIL_FROM=aesculap <noreply@example.ru>
ALERT_EMAIL=

# Telegram-бот уведомлений поставщикам (пусто — выключен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

STOREFRONT_REQUIRE_PAYOUTS=true

# Демо-стенд без ключей: заглушки оплаты/доставки/почты, закрыт от поисковиков, пароль демо-входов
# ALLOW_TEST_PROVIDERS=1
# SITE_NOINDEX=1
# DEMO_PASSWORD=
ORDER_PAY_MINUTES=30
SHIPMENT_CONFIRM_HOURS=48
STORAGE_DRIVER=local

# Реквизиты оператора для /legal/* (сервис web)
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Подпись ссылок «Отписаться» в рассылках (случайная строка; при смене старые ссылки перестанут работать)
UNSUBSCRIBE_SECRET=
