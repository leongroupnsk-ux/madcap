{
  "name": "aesculap",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @aesculap/api prisma:migrate",
    "db:seed": "pnpm --filter @aesculap/api prisma:seed",
    "db:demo": "pnpm --filter @aesculap/api db:demo"
  }
}
