# Dev: хостовые PostgreSQL (5432) и Redis (6379); Docker не используется из-за места на диске.
DATABASE_URL=postgresql://aesculap:aesculap@localhost:5432/aesculap
REDIS_URL=redis://localhost:6379/5
API_PORT=4100
WEB_ORIGIN=http://localhost:4000
API_INTERNAL_URL=http://localhost:4100
SESSION_SECRET=change-me-dev-only
# Хранилище файлов: local (dev) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# Почта: console (dev, письма в лог) | smtp
MAIL_DRIVER=console
BRAND_NAME=aesculap
# Витрина показывает товары только поставщиков с подключёнными выплатами (ТЗ). В dev до этапа 4 — false.
STOREFRONT_REQUIRE_PAYOUTS=true
# Публичный адрес сайта для canonical, sitemap и разметки
SITE_URL=http://localhost:4000
