# Dev: хостовые PostgreSQL (5432) и Redis (6379); Docker не используется из-за места на диске.
DATABASE_URL=postgresql://aesculap:aesculap@localhost:5432/aesculap
REDIS_URL=redis://localhost:6379/5
API_PORT=4100
WEB_ORIGIN=http://localhost:4000
API_INTERNAL_URL=http://localhost:4100
SESSION_SECRET=change-me-dev-only
# Хранилище файлов: local (dev) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# Почта: console (dev, письма в лог) | smtp
MAIL_DRIVER=console
BRAND_NAME=aesculap
# Витрина показывает товары только поставщиков с подключёнными выплатами (ТЗ). С этапа 4 включено и в dev.
STOREFRONT_REQUIRE_PAYOUTS=true
# Публичный адрес сайта для canonical, sitemap и разметки
SITE_URL=http://localhost:4000
# Доставка: fake (офлайн-заглушка) | cdek (API v2). Для тестового контура СДЭК укажите
# CDEK_API_URL=https://api.edu.cdek.ru/v2 и тестовые ключи из документации СДЭК.
DELIVERY_DRIVER=fake
CDEK_API_URL=https://api.edu.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Оплата: fake (тестовая страница /pay/test) | yookassa (нужны YOOKASSA_SHOP_ID и YOOKASSA_SECRET_KEY)
PAYMENTS_DRIVER=fake
ORDER_PAY_MINUTES=30
SHIPMENT_CONFIRM_HOURS=48
# Почта в бою: MAIL_DRIVER=smtp и адрес SMTP транзакционного сервиса
SMTP_URL=
MAIL_FROM=aesculap <noreply@example.ru>
# Telegram-бот уведомлений поставщикам (пусто — бот выключен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
